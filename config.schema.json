{
  "pluginAlias": "FreeboxPop",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/player/settingsUi",
  "schema": {
    "type": "object",
    "properties": {
      "channels": {
        "title": "Channels",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Switch name",
              "type": "string",
              "required": true
            },
            "oqeeChannelId": {
              "title": "OQEE channel id",
              "type": "integer",
              "required": true,
              "description": "The id in https://oq.ee/channel/<id>/play (TF1 is 536)."
            }
          }
        }
      }
    }
  }
}
